{
  "name": "diffpane",
  "version": "1.0.2",
  "private": true,
  "description": "A quiet, live view of your working tree",
  "type": "module",
  "scripts": {
    "build:icons": "node app/tooling/icons/build-icons.ts",
    "build": "vp run bundle",
    "start": "node app/tooling/commands/start.ts",
    "test": "vp test",
    "install:app": "node app/tooling/distribution/install.ts",
    "package:app": "node app/tooling/distribution/install.ts --build-only",
    "setup:languages": "node app/tooling/dependencies/setup-languages.ts",
    "setup:howmany": "node app/tooling/dependencies/setup-howmany.ts",
    "test:languages": "node app/tests/tooling/languages/languages.integration.mjs",
    "prepare": "vp config --no-agent && node app/tooling/commands/prepare-terminal.ts",
    "dev": "node app/tooling/commands/dev.ts",
    "preview": "vp preview",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test:watch": "vp test watch",
    "test:docs": "vp test app/tests/tooling/quality/docs.test.mjs",
    "verify": "node .pnpmfile.mjs && vp check && cargo fmt --check --manifest-path src-tauri/Cargo.toml && vp test && vp run bundle && cargo test --locked --manifest-path src-tauri/Cargo.toml --target-dir target/diffpane-tauri"
  },
  "dependencies": {
    "@parcel/watcher": "2.6.0",
    "basedpyright": "1.40.2",
    "diff": "9.0.0",
    "marked": "^18.1.1",
    "node-pty": "1.1.0",
    "smol-toml": "1.9.0",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@audio/decode-opus": "1.3.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@oddbird/popover-polyfill": "0.7.3",
    "@shikijs/core": "4.5.0",
    "@shikijs/engine-oniguruma": "4.5.0",
    "@shikijs/langs": "4.5.0",
    "@shikijs/magic-move": "4.5.0",
    "@shikijs/monaco": "4.5.0",
    "@shikijs/themes": "4.5.0",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/cli": "2.12.4",
    "@types/canvas-confetti": "1.9.0",
    "@types/d3-hierarchy": "3.1.7",
    "@types/d3-shape": "3.2.0",
    "@wasm-audio-decoders/ogg-vorbis": "0.1.20",
    "@wooorm/starry-night": "3.11.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "canvas-confetti": "1.9.4",
    "colorthief": "3.5.0",
    "d3-hierarchy": "3.1.2",
    "d3-shape": "3.2.0",
    "dompurify": "^3.4.17",
    "linguist-languages": "9.5.0",
    "material-icon-theme": "5.39.0",
    "mermaid": "^12.2.0",
    "monaco-editor": "^0.57.0",
    "number-flow": "0.6.2",
    "pixelmatch": "8.0.0",
    "playwright": "1.65.1",
    "roughjs": "4.6.6",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "wavesurfer.js": "7.12.12"
  },
  "engines": {
    "node": "^22.22.2 || ^24.11.0 || >=26.0.0",
    "pnpm": ">=12.15.0"
  },
  "packageManager": "pnpm@12.15.0"
}
