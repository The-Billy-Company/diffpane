{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "workspace",
  "description": "Allow an app-owned workspace view to use its desktop bridge and native window controls.",
  "webviews": ["workspace-*"],
  "permissions": [
    "allow-desktop-connect",
    "allow-desktop-invoke",
    "allow-desktop-send",
    "allow-desktop-shortcut-prefix",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize"
  ]
}
